# ==============================================================================
# CognitionOS System Environment Template
# Copy this file to .env and configure secret keys prior to starting applications
# ==============================================================================

# --- Global Settings ---
PROJECT_NAME=CognitionOS
ENVIRONMENT=development # development | staging | production
DEBUG=true
API_PORT=8000

# --- Core Security ---
# Generate using: openssl rand -hex 32
JWT_SECRET_KEY=replace_this_with_a_secure_cryptographic_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENCRYPTION_KEY=replace_this_with_a_32_byte_base64_encryption_key

# --- Relational Database (PostgreSQL) ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=cognition_admin
DATABASE_PASSWORD=cognition_secure_pass
DATABASE_NAME=cognition_db
DATABASE_URL=postgresql+asyncpg://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}

# --- Cache and Message Broker (Redis) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_pass
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0

# --- Vector Database (ChromaDB / Pinecone) ---
VECTOR_DB_PROVIDER=chroma # chroma | pinecone
CHROMA_PERSIST_DIRECTORY=./infrastructure/chroma_db
PINECONE_API_KEY=your_pinecone_api_key_if_applicable
PINECONE_ENVIRONMENT=your_pinecone_environment

# --- Model & Large Language Model Providers ---
OPENAI_API_KEY=your_openai_api_key
HUGGINGFACE_API_TOKEN=your_huggingface_token
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=CognitionOS-Agents
LANGCHAIN_API_KEY=your_langsmith_api_key

# --- Research & ML Experimentation ---
MLFLOW_TRACKING_URI=http://localhost:5000
WANDB_API_KEY=your_weights_and_biases_api_key
WANDB_PROJECT=CognitionOS

# --- Ethical Governance ---
ANONYMIZE_PII_IN_MEMORY=true
BIAS_MONITORING_THRESHOLD=0.15 # Max allowable variance in model bias audit
ENABLE_EXPLAINABILITY_GENERATION=true
ALLOW_CLINICAL_ADVICE_EXTRACTION=false # Strictly enforce mental wellness vs diagnostic boundaries

# --- Observability & Monitoring ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOG_LEVEL=INFO # DEBUG | INFO | WARNING | ERROR
